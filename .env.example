# NFT Platform Environment Configuration

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=nft_platform
DB_SSL_MODE=disable
DB_TIMEZONE=UTC
DB_MAX_OPEN_CONNS=100
DB_MAX_IDLE_CONNS=10
DB_MAX_LIFETIME_MINUTES=60
DB_LOG_LEVEL=warn

# Test Database Configuration
TEST_DB_HOST=localhost
TEST_DB_PORT=5432
TEST_DB_USER=postgres
TEST_DB_PASSWORD=postgres
TEST_DB_NAME=nft_platform_test

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=10
REDIS_MIN_IDLE_CONNS=2
REDIS_MAX_RETRIES=3
REDIS_DIAL_TIMEOUT=5
REDIS_READ_TIMEOUT=3
REDIS_WRITE_TIMEOUT=3
REDIS_POOL_TIMEOUT=4
REDIS_IDLE_TIMEOUT=300

# Test Redis Configuration
TEST_REDIS_HOST=localhost
TEST_REDIS_PORT=6379
TEST_REDIS_PASSWORD=
TEST_REDIS_DB=1

# Kafka Configuration
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=nft-platform
KAFKA_GROUP_ID=nft-platform-group
KAFKA_MIN_BYTES=1
KAFKA_MAX_BYTES=10485760
KAFKA_MAX_WAIT_MS=500
KAFKA_READ_TIMEOUT_S=10
KAFKA_WRITE_TIMEOUT_S=10
KAFKA_BATCH_SIZE=100
KAFKA_BATCH_TIMEOUT_MS=1000
KAFKA_REQUIRED_ACKS=1
KAFKA_RETRY_MAX=3
KAFKA_RETRY_BACKOFF_MS=1000
KAFKA_ASYNC=false

# Test Kafka Configuration
TEST_KAFKA_BROKERS=localhost:9092

# Blockchain Configuration
BLOCKCHAIN_RPC_ENDPOINT=https://sepolia.infura.io/v3/YOUR_PROJECT_ID
BLOCKCHAIN_WS_ENDPOINT=wss://sepolia.infura.io/ws/v3/YOUR_PROJECT_ID
BLOCKCHAIN_CHAIN_ID=11155111
BLOCKCHAIN_PRIVATE_KEY=YOUR_PRIVATE_KEY_HERE
BLOCKCHAIN_GAS_PRICE=20000000000
BLOCKCHAIN_MAX_GAS_PRICE=100000000000
BLOCKCHAIN_GAS_LIMIT=300000
BLOCKCHAIN_CONFIRMATION_BLOCKS=3
BLOCKCHAIN_TX_TIMEOUT_MINUTES=5
BLOCKCHAIN_RETRY_ATTEMPTS=3
BLOCKCHAIN_RETRY_DELAY_SECONDS=10

# Contract Addresses (to be filled after deployment)
CONTRACT_NFT_ADDRESS=
CONTRACT_AUCTION_ADDRESS=
CONTRACT_MARKET_ADDRESS=

# Test Blockchain Configuration
TEST_BLOCKCHAIN_RPC=http://localhost:8545
TEST_BLOCKCHAIN_WS=ws://localhost:8545
TEST_CHAIN_ID=1337
TEST_PRIVATE_KEY=

# Server Configuration
PORT=8080
GIN_MODE=debug
JWT_SECRET=your-jwt-secret-key-here
JWT_EXPIRY=24h

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=10

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# File Upload
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/gif,image/webp

# WebSocket
WS_READ_BUFFER_SIZE=1024
WS_WRITE_BUFFER_SIZE=1024
WS_PING_PERIOD=54s
WS_PONG_WAIT=60s
WS_WRITE_WAIT=10s